Exp 9: Split Deployment - Vercel Form Frontend + Ngrok Tunnel + MySQL Backend
# 1. Install Apache, PHP, MySQL stack
sudo apt install apache2 php libapache2-mod-php mysql-server php-mysql -y

# 2. Create Database and Table in MySQL
sudo mysql -u root

-- Inside MySQL:
CREATE DATABASE web_project;
USE web_project;
CREATE TABLE contacts (
   id INT AUTO_INCREMENT PRIMARY KEY,
   name VARCHAR(50),
   email VARCHAR(100),
   message TEXT
);
EXIT;

# 3. Create Backend PHP Script (/var/www/html/submit.php)
sudo tee /var/www/html/submit.php << 'EOF'
<?php
$conn = new mysqli("localhost", "root", "", "web_project");
if ($conn->connect_error) {
   die("Connection failed: " . $conn->connect_error);
}
$name = $_POST['name'];
$email = $_POST['email'];
$message = $_POST['message'];

$sql = "INSERT INTO contacts (name, email, message) VALUES ('name','email', '$message')";
if (conn->query(sql) === TRUE) {
   echo "Data saved successfully!";
} else {
   echo "Error: " . $sql . "<br>" . $conn->error;
}
$conn->close();
?>
EOF

# 4. Install and Start Ngrok Tunnel (to expose local Apache to Vercel frontend)
mkdir -p ~/ngrok-setup && cd ~/ngrok-setup
wget https://bin.equinox.io/c/bNyj1mQVY4c/ngrok-v3-stable-linux-amd64.tgz
tar -xvzf ngrok-v3-stable-linux-amd64.tgz
sudo mv ngrok /usr/local/bin/

# Authenticate ngrok and expose Port 80:
# (Replace with your own authtoken if needed)
ngrok config add-authtoken 3K3NP7STN3MNE6L35r6x130b2eP_5uAqExGEy8Uq8cyn9m513
ngrok http 80
# Copy the Forwarding HTTPS URL: e.g., https://your-subdomain.ngrok-free.dev

# 5. Create Frontend HTML Form (Deploy this repo to Vercel)
# Replace the action URL with your ngrok forwarding URL:
cat << 'EOF' > index.html
<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
